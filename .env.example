# RouteFlow Environment Variables Template
# Copy this file to '.env.local' in the root directory and fill in your actual credentials.
#
# IMPORTANT: When deploying to Vercel, make sure to add these same keys
# (with their corresponding production values) in the Vercel Deployment Dashboard
# under Settings > Environment Variables.

# Supabase Configurations
# Obtain these from your Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# Google Maps API Configuration
# Obtain this from the Google Cloud Console with Places API and Geocoding API enabled
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
